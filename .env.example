# VerzZify — environment template
# Copy to .env locally. On Render, these SAME names are in render.yaml.

# --- Runtime ---
NODE_VERSION=22
NODE_ENV=production
NITRO_PRESET=node-server
PORT=10000
VITE_AUTH_ENABLED=false
VITE_PUBLIC_HOSTNAME=verzzify.com

# --- Auth ---
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
BETTER_AUTH_URL=https://verzzify.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Postgres (one of these; DATABASE_URL is preferred) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DATABASE_URL=
POSTGRES_URL=

# --- Supabase API ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_REGION=eu-west-1
S3_MASTERS_BUCKET=verzzify-masters
S3_STREAM_BUCKET=verzzify-stream
S3_PUBLIC_BUCKET=verzzify-public
# S3_ENDPOINT=http://127.0.0.1:9000

# --- Catalog ---
YOUTUBE_API_KEY=
JAMENDO_CLIENT_ID=

# --- Later ---
FCM_PROJECT_ID=
PAYMENT_WEBHOOK_SECRET=
VITE_API_BASE=https://verzzify.com/api/v1
