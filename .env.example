# Sheba Music — environment template
# Copy to .env and fill from a secrets manager. Never commit real values.

# --- Web preview (TanStack Start + Postgres) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/sheba
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:8080

# OAuth (optional — email/password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Production Flutter / NestJS (see docs/architecture.md) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# S3_MASTERS_BUCKET=sheba-masters
# S3_STREAM_BUCKET=sheba-stream
# S3_PUBLIC_BUCKET=sheba-public
# YOUTUBE_API_KEY=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# PAYMENT_WEBHOOK_SECRET=
# VITE_API_BASE=https://api.sheba.example/api/v1
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
